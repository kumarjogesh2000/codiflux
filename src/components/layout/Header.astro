---
/**
 * Header.astro
 * Site-wide top navigation bar.
 *
 * Architecture decisions:
 * - Static Astro component (no React) — no JS needed for the shell
 * - Uses CSS + tiny IntersectionObserver for scroll-aware styling
 * - MobileMenu.tsx (React island) hydrated with client:load for interactivity
 * - Logo is inline gradient text for crisp rendering at all sizes
 */
import Nav from './Nav.astro';
import MobileMenu from './MobileMenu';
import { SITE, NAV_ITEMS } from '@/lib/constants';

const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-50 transition-all duration-300"
>
  <!-- Backdrop blur panel -->
  <div
    id="header-inner"
    class="border-b border-transparent transition-all duration-300"
  >
    <div class="container">
      <div class="flex h-16 items-center justify-between gap-8">

        <!-- ── Logo ──────────────────────────────────────────── -->
        <a
          href="/"
          class="flex items-center gap-2 font-bold text-xl tracking-tight shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-sm"
          aria-label={`${SITE.name} — Go to homepage`}
        >
          <span class="gradient-text">{SITE.name}</span>
        </a>

        <!-- ── Desktop Navigation ────────────────────────────── -->
        <div class="hidden md:block">
          <Nav currentPath={currentPath} />
        </div>

        <!-- ── Right: CTA + Mobile Toggle ───────────────────── -->
        <div class="flex items-center gap-3">
          <a
            href="/contact"
            class="hidden sm:inline-flex items-center gap-2 px-5 py-2 rounded-md
                   bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium
                   transition-all duration-200
                   hover:shadow-[0_0_24px_rgba(124,58,237,0.45)]
                   active:scale-[0.97]
                   focus-visible:outline-none focus-visible:ring-2
                   focus-visible:ring-brand-500 focus-visible:ring-offset-2
                   focus-visible:ring-offset-[var(--color-surface-base)]"
            id="header-cta"
          >
            Start a Project
          </a>

          <!-- MobileMenu island — only hydrated on mobile (client:load) -->
          <MobileMenu
            client:load
            navItems={NAV_ITEMS}
            currentPath={currentPath}
          />
        </div>

      </div>
    </div>
  </div>
</header>

<!-- Header offset spacer — prevents content from hiding behind fixed header -->
<div aria-hidden="true" class="h-16"></div>

<script>
  /**
   * Scroll-aware header.
   * Adds `data-scrolled` attribute when the page scrolls past the header.
   * CSS handles the visual transition — no inline style thrashing.
   */
  const header = document.getElementById('site-header');
  const inner  = document.getElementById('header-inner');

  if (header && inner) {
    const onScroll = () => {
      const scrolled = window.scrollY > 20;
      if (scrolled) {
        inner.classList.add('glass', 'border-[var(--color-border-subtle)]');
        inner.classList.remove('border-transparent');
      } else {
        inner.classList.remove('glass', 'border-[var(--color-border-subtle)]');
        inner.classList.add('border-transparent');
      }
    };

    // Run once on mount
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
