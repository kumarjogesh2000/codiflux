---
/**
 * CTA.astro — Full-width conversion call-to-action section.
 *
 * The closing section of the home page — drives visitors to either
 * start a project or view the portfolio.
 *
 * Aesthetic: Deep Space Navy with a subtle Core Blue ambient orb.
 * Electric Cyan eyebrow, white headline, restrained motion.
 */
import Button from '@/components/ui/Button.astro';
import { SITE } from '@/lib/constants';
---

<section
  id="cta"
  aria-label="Call to action"
  class="section-padding relative overflow-hidden"
>
  <!-- Background — very restrained, not neon -->
  <div aria-hidden="true" class="absolute inset-0 pointer-events-none">
    <!-- Dot grid -->
    <div
      class="absolute inset-0 dot-grid opacity-[0.012]"
    ></div>
    <!-- Core Blue ambient orb from top center — subtle beacon -->
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[320px]
             opacity-[0.09] blur-[100px]"
      style="background: radial-gradient(ellipse at 50% 0%, #2563EB, transparent 70%);"
    ></div>
    <!-- Hairline top border glow -->
    <div
      class="absolute top-0 left-0 right-0 h-px"
      style="background: linear-gradient(90deg, transparent, rgba(37,99,235,0.20) 50%, transparent);"
    ></div>
  </div>

  <div class="container relative z-10">
    <div class="max-w-3xl mx-auto text-center">

      <!-- Eyebrow -->
      <p class="mb-4 text-[0.6875rem] font-semibold uppercase tracking-[0.12em] text-[var(--color-accent-cyan)] opacity-85">
        Ready to build?
      </p>

      <!-- Headline -->
      <h2 class="text-4xl font-bold tracking-[-0.025em] text-[var(--color-text-primary)] sm:text-5xl lg:text-6xl leading-[1.1]">
        Let's build something<br />
        <span class="gradient-text">worth being proud of.</span>
      </h2>

      <!-- Sub-copy -->
      <p class="mt-6 text-lg text-[var(--color-text-secondary)] leading-relaxed max-w-xl mx-auto">
        Every project starts with a conversation. Tell us what you're building and
        we'll tell you exactly how we can help — no pressure, no sales script.
      </p>

      <!-- Action buttons -->
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="/contact" size="lg" id="cta-section-primary">
          Start a Project
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </Button>
        <Button href="/portfolio" variant="ghost" size="lg" id="cta-section-portfolio">
          View Our Portfolio
        </Button>
      </div>

      <!-- Trust signals -->
      <div class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-6 text-xs text-[var(--color-text-tertiary)]">
        {[
          'Free initial consultation',
          'No long-term contracts',
          'Response within 24 hours',
        ].map((signal) => (
          <div class="flex items-center gap-2">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-accent-cyan)] opacity-70 shrink-0" aria-hidden="true">
              <path d="M20 6 9 17l-5-5"/>
            </svg>
            <span>{signal}</span>
          </div>
        ))}
      </div>

      <!-- Email direct link -->
      <p class="mt-8 text-sm text-[var(--color-text-tertiary)]">
        Prefer email?{' '}
        <a
          href={`mailto:${SITE.email}`}
          class="text-[var(--color-text-secondary)] hover:text-[var(--color-accent-cyan)]
                 transition-colors duration-200 underline underline-offset-2"
        >
          {SITE.email}
        </a>
      </p>

    </div>
  </div>

</section>
