---
/**
 * Badge.astro — Pill label for categories, tech stack tags, status labels.
 *
 * Aesthetic: Linear / Vercel — clean, flat, not colourful.
 * The `brand` variant uses Electric Cyan text on a deep navy tint
 * for high-end highlighting without neon aggression.
 *
 * Usage:
 *   <Badge>WordPress</Badge>
 *   <Badge variant="brand">Featured</Badge>
 *   <Badge variant="success" size="sm">Live</Badge>
 */

type BadgeVariant = 'default' | 'brand' | 'outline' | 'success';
type BadgeSize    = 'sm' | 'md';

interface Props {
  variant?: BadgeVariant;
  size?:    BadgeSize;
  class?:   string;
  id?:      string;
}

const {
  variant = 'default',
  size    = 'md',
  class: className,
  id,
} = Astro.props;

const sizes: Record<BadgeSize, string> = {
  sm: 'px-2 py-0.5 text-[0.6875rem] leading-4',
  md: 'px-2.5 py-1 text-xs leading-4',
};

const variants: Record<BadgeVariant, string> = {
  // Neutral — used for tech stack tags, general labels
  default: [
    'bg-[var(--color-bg-overlay)]',
    'text-[var(--color-text-secondary)]',
    'border border-[var(--color-border-base)]',
  ].join(' '),

  // Brand — cyan text on deep navy, for featured / highlight labels
  brand: [
    'bg-[rgba(0,229,255,0.06)]',
    'text-[var(--color-accent-cyan)]',
    'border border-[rgba(0,229,255,0.18)]',
  ].join(' '),

  // Outline — purely border, transparent fill
  outline: [
    'bg-transparent',
    'text-[var(--color-text-secondary)]',
    'border border-[var(--color-border-base)]',
  ].join(' '),

  // Success — green for live / active states
  success: [
    'bg-emerald-950/60',
    'text-emerald-400',
    'border border-emerald-900/50',
  ].join(' '),
};

const classes = [
  'inline-flex items-center font-medium rounded-md',
  'whitespace-nowrap tracking-wide',
  sizes[size],
  variants[variant],
  className ?? '',
].join(' ');
---

<span id={id} class={classes}>
  <slot />
</span>
