---

<section
  id="services"
  aria-labelledby="services-heading"
  class="section-padding bg-[var(--color-surface-raised)]"
>
  <div class="container">

    <!-- Section header -->
    <div class="mb-16 flex justify-center">
      <SectionHeader
        eyebrow="What We Build"
        heading="Services built for"
        accent="real results."
        subtext="From CMS platforms to custom React applications — we match the right technology to your business goals, not the other way around."
        id="services-heading"
      />
    </div>

    <!-- Services grid -->
    <ul
      role="list"
      class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"
    >
      {SERVICES.map((service) => {
        const iconPath = icons[service.icon] ?? icons.code;
        return (
          <li>
            <article
              class:list={[
                'group relative h-full p-7 rounded-xl',
                'bg-[var(--color-surface-base)] border',
                'transition-all duration-300',
                'hover:-translate-y-1 hover:shadow-[var(--shadow-card-hover)]',
                service.featured
                  ? 'border-brand-800/50 hover:border-brand-700/70'
                  : 'border-[var(--color-border-subtle)] hover:border-[var(--color-border-base)]',
              ]}
              aria-label={service.title}
            >
              <!-- Featured indicator -->
              {service.featured && (
                <span
                  class="absolute top-0 left-7 -translate-y-1/2 px-2.5 py-0.5 rounded-full
                         text-[10px] font-semibold uppercase tracking-widest
                         bg-brand-600 text-white"
                  aria-label="Featured service"
                >
                  Popular
                </span>
              )}

              <!-- Icon -->
              <div
                class="mb-5 flex items-center justify-center w-11 h-11 rounded-lg
                       bg-brand-900/40 border border-brand-800/30
                       group-hover:bg-brand-800/40 transition-colors duration-300"
                aria-hidden="true"
              >
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-brand-400"
                >
                  <path d={iconPath} />
                </svg>
              </div>

              <!-- Title -->
              <h3 class="mb-2.5 text-base font-semibold text-[var(--color-text-primary)]">
                {service.title}
              </h3>

              <!-- Description -->
              <p class="mb-5 text-sm leading-relaxed text-[var(--color-text-secondary)]">
                {service.description}
              </p>

              <!-- Platform badges -->
              {service.platforms && service.platforms.length > 0 && (
                <div class="flex flex-wrap gap-1.5" aria-label="Technologies used">
                  {service.platforms.slice(0, 3).map((platform) => (
                    <Badge variant="default" size="sm">{platform}</Badge>
                  ))}
                  {service.platforms.length > 3 && (
                    <Badge variant="outline" size="sm">+{service.platforms.length - 3}</Badge>
                  )}
                </div>
              )}

              <!-- Hover arrow -->
              <div
                class="absolute bottom-7 right-7 w-7 h-7 rounded-md
                       flex items-center justify-center
                       text-[var(--color-text-tertiary)]
                       group-hover:text-brand-400 group-hover:bg-brand-900/40
                       transition-all duration-300"
                aria-hidden="true"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>

            </article>
          </li>
        );
      })}
    </ul>

    <!-- Bottom CTA -->
    <div class="mt-12 text-center">
      <a
        href="/services"
        class="inline-flex items-center gap-2 text-sm font-medium
               text-[var(--color-text-secondary)] hover:text-brand-400
               transition-colors duration-200 group"
      >
        Explore all services
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

  </div>
</section>
