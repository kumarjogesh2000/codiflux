---
/**
 * Header.astro
 * Site-wide top navigation bar.
 *
 * Architecture decisions:
 * - Static Astro component (no React) — no JS needed for the shell
 * - Uses CSS + tiny IntersectionObserver for scroll-aware styling
 * - MobileMenu.tsx (React island) hydrated with client:load for interactivity
 * - Logo is inline gradient text for crisp rendering at all sizes
 *
 * Aesthetic: Linear / Vercel — clean glass bar, Core Blue CTA,
 * Deep Space Navy backdrop on scroll.
 */
import Nav from './Nav.astro';
import MobileMenu from './MobileMenu';
import { SITE, NAV_ITEMS } from '@/lib/constants';

const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-50 transition-all duration-300"
>
  <!-- Backdrop blur panel -->
  <div
    id="header-inner"
    class="border-b border-transparent transition-all duration-300"
  >
    <div class="container">
      <div class="flex h-16 items-center justify-between gap-8">

        <!-- ── Logo ──────────────────────────────────────────── -->
        <a
          href="/"
          class="flex items-center gap-2.5 shrink-0 group
                 focus-visible:outline-none focus-visible:ring-2
                 focus-visible:ring-[var(--color-accent-blue)] rounded-sm
                 transition-opacity duration-200 hover:opacity-90"
          aria-label={`${SITE.name} — Go to homepage`}
        >
          <!-- Circular logo mark -->
          <img
            src="/images/logo-mark.png"
            alt=""
            aria-hidden="true"
            width="36"
            height="36"
            class="h-9 w-9 rounded-full object-cover shrink-0"
            loading="eager"
            decoding="async"
          />
          <!-- Site name — hidden on xs, visible from sm -->
          <span class="hidden sm:block font-bold text-lg tracking-[-0.02em] gradient-text leading-none">
            {SITE.name}
          </span>
        </a>

        <!-- ── Desktop Navigation ────────────────────────────── -->
        <div class="hidden md:block">
          <Nav currentPath={currentPath} />
        </div>

        <!-- ── Right: CTA + Mobile Toggle ───────────────────── -->
        <div class="flex items-center gap-3">
          <a
            href="/contact"
            class="hidden sm:inline-flex items-center gap-2 px-5 py-2 rounded-lg
                   bg-[var(--color-accent-blue)] hover:bg-[var(--color-accent-blue-hover)]
                   text-white text-sm font-medium
                   border border-[var(--color-accent-blue)]
                   hover:border-[var(--color-accent-blue-hover)]
                   shadow-[0_0_0px_rgba(37,99,235,0)]
                   hover:shadow-[0_0_20px_rgba(37,99,235,0.30)]
                   transition-all duration-200
                   active:scale-[0.97]
                   focus-visible:outline-none focus-visible:ring-2
                   focus-visible:ring-[var(--color-accent-blue)] focus-visible:ring-offset-2
                   focus-visible:ring-offset-[var(--color-bg-base)]"
            id="header-cta"
          >
            Start a Project
          </a>

          <!-- MobileMenu island — only hydrated on mobile (client:load) -->
          <MobileMenu
            client:load
            navItems={NAV_ITEMS}
            currentPath={currentPath}
          />
        </div>

      </div>
    </div>
  </div>
</header>

<!-- Header offset spacer — prevents content from hiding behind fixed header -->
<div aria-hidden="true" class="h-16"></div>

<script>
  /**
   * Scroll-aware header.
   * Adds Deep Space Navy glass effect when the page scrolls past 20px.
   * Uses data attribute — CSS handles the visual transition.
   */
  const inner = document.getElementById('header-inner');

  if (inner) {
    const onScroll = () => {
      const scrolled = window.scrollY > 20;
      if (scrolled) {
        inner.style.background   = 'rgba(11, 18, 33, 0.85)';
        inner.style.backdropFilter = 'blur(16px) saturate(1.2)';
        inner.style.webkitBackdropFilter = 'blur(16px) saturate(1.2)';
        inner.classList.add('border-[var(--color-border-subtle)]');
        inner.classList.remove('border-transparent');
      } else {
        inner.style.background = '';
        inner.style.backdropFilter = '';
        inner.style.webkitBackdropFilter = '';
        inner.classList.remove('border-[var(--color-border-subtle)]');
        inner.classList.add('border-transparent');
      }
    };

    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
